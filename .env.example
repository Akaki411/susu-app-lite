# ─────────────────────────────────────────────────────────────────────────────
# == ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ ==
# Требуется скопировать в .env и заполнить своими значениями
# Значение IS_DEV управляет режимом работы: если true, то CORS и Redis отключаются
# Один процесс rari отдаёт и фронтенд, и API (src/app/api/**) - отдельного бэкенда нет
# ─────────────────────────────────────────────────────────────────────────────

# Режим разработки. Отсутствие переменной или false = продакшн режим
IS_DEV=true

# Порт rari-сервера (сикс-севен)
PORT=6767

# Внешний API шлюз. Проксируется через src/app/api/** для обхода CORS
SUSU_API_BASE=https://online.susu.ru/microgateway

# Точка подключения к Redis, там кеш расписания/рейтинга и HLL-счётчик уникальных IP
# В DEV-режиме не используется, все хранится в ОЗУ, но подключение можно проверить и в DEV при желании
REDIS_URL=redis://127.0.0.1:6379

# Путь к файлу SQLite. Там хронятся логи посещения. Папка создаётся при старте автоматически
SQLITE_PATH=data/database.db

# Время жизни кеша расписания и рейтингов в секундах. По истечению кеш выгружается и запрашивается новая версия
SCHEDULE_TTL=3600
RATING_TTL=600

# Заголовок с реальным IP клиента (для счётчика уникальных IP)
# Приложение за nginx: обычно x-forwarded-for или x-real-ip
TRUSTED_IP_HEADER=x-forwarded-for

# Начальный админ: userId, которому открыта статистика (опционально)
# Можно оставить пустым и добавлять админов в любой момент скриптом:
# bun run addadmin <userId>
ADMIN_SEED=
